# Fonction pour visualiser l'effet géométrique d'une composante 
library(ggplot2)

# Fonction pour trouver la description des composantes principales
tracer_mode_variation <- function(mfpca_obj, pc = 1, k = 2) {
  
  # Grille temporelle [0, 2pi]
  temps <- seq(0, 2*pi, length.out = 200)
  
  # Évaluation des fonctions moyennes mu_x(t) et mu_y(t)
  mu_x <- mfpca_obj$meanFunction[[1]]@X[1, ]
  mu_y <- mfpca_obj$meanFunction[[2]]@X[1, ]
  
  # Évaluation des fonctions propres (harmonies) pour la PC choisie
  ef_x <- mfpca_obj$functions[[1]]@X[pc, ]
  ef_y <- mfpca_obj$functions[[2]]@X[pc, ]
  
  # Écart-type du score pour la PC
  sd_score <- sd(mfpca_obj$scores[, pc])
  
  # Construction des contours (+/- k * SD)
  df_plot <- data.frame(
    temps = rep(temps, 3),
    Type = rep(c("Forme Moyenne", paste0("+", k, " SD"), paste0("-", k, " SD")), each = length(temps)),
    x = c(mu_x, mu_x + k * sd_score * ef_x, mu_x - k * sd_score * ef_x),
    y = c(mu_y, mu_y + k * sd_score * ef_y, mu_y - k * sd_score * ef_y)
  )
  
  # Graphique ggplot2
  ggplot(df_plot, aes(x = x, y = y, color = Type, linetype = Type)) +
    geom_path(linewidth = 1) +
    scale_color_manual(values = c("Forme Moyenne" = "black", "+2 SD" = "red", "-2 SD" = "blue")) +
    scale_linetype_manual(values = c("Forme Moyenne" = "solid", "+2 SD" = "dashed", "-2 SD" = "dotted")) +
    coord_fixed() +
    labs(
      title = paste0("Mode de variation géométrique : PC", pc),
      subtitle = "Noir : Moyenne | Rouge : +2 SD | Bleu : -2 SD",
      x = "Coordonnée X", y = "Coordonnée Y"
    ) +
    theme_minimal(base_size = 12)
}

