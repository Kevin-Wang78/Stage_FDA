message("Nombre de contours utilisés pour FPCA : ", nb_valides)

# Grille temporelle
temps <- seq(0, 2 * pi, length.out = 200)

# Matrices X et Y 
matrice_X <- t(sapply(formes_valides, function(f) f$x))
matrice_Y <- t(sapply(formes_valides, function(f) f$y))

array_contours <- array(0, dim = c(200, nb_valides, 2))
array_contours[,,1] <- t(matrice_X)
array_contours[,,2] <- t(matrice_Y)

# Création d'une base fonctionnelle périodique
fourier_basis <- create.fourier.basis(rangeval = c(0, 2*pi), nbasis = 29)

# Transformation en objet fonctionnel bivarié (fd)
fd_contours <- smooth.basis(temps, array_contours, fourier_basis)$fd

# Algorithme de PFCA
fpca_result <- pca.fd(fd_contours, nharm = 6)

# Extraction des variances et affichage
variances <- fpca_result$varprop * 100
variance_cumulee <- cumsum(variances)

tableau_variance <- data.frame(
  Composante = paste0("FPC", 1:6),
  `Variance_Expliquee (%)` = round(variances[1:6], 2),
  `Variance_Cumulee (%)` = round(variance_cumulee[1:6], 2)
)

print(tableau_variance)

# Récupération des scores fonctionnels réels 
scores_FPCA <- apply(fpca_result$scores[, 1:6, ], 1, c)
scores_FPCA <- t(scores_FPCA)

# Donner des noms clairs aux colonnes
colnames(scores_FPCA) <- c(paste0("PC", 1:6, "_X"), paste0("PC", 1:6, "_Y"))

# Extraction des valeurs propres et calcul des écarts-types uniques
lambdas <- fpca_result$values # Valeur propre unique pour chaque composante
sd_harmonics <- sqrt(lambdas) # Calcul de l'ecart-type

# Variances en pourcentage
var_pct <- round(fpca_result$varprop * 100, 2)

# Préparation du graphique 2x3 (pour afficher PC1 à PC6 par exemple)
par(mfrow = c(2, 3), mar = c(4, 4, 3, 1))

# Grille de temps fine pour tracer les courbes lisses
t_grid <- seq(0, 2 * pi, length.out = 200)

# Courbe moyenne bivariée mu(t) = (mu_x(t), mu_y(t))
mean_fd <- fpca_result$meanfd
mean_eval <- eval.fd(t_grid, mean_fd) # Matrice 200 x 1 x 2
mean_x <- mean_eval[, 1, 1]
mean_y <- mean_eval[, 1, 2]

# Fonctions propres psi_k(t)
harmonics_fd <- fpca_result$harmonics
harm_eval <- eval.fd(t_grid, harmonics_fd) # Matrice 200 x nharm x 2

# Boucle sur toutes les composantes
nombre_composantes <- 6
for (k in 1:nombre_composantes) {
  
  # L'écart-type unique pour la composante k (comme indiqué par ton prof)
  sd_k <- sd_harmonics[k]
  
  # Fonctions propres pour X et Y associées à la composante k
  psi_kx <- harm_eval[, k, 1]
  psi_ky <- harm_eval[, k, 2]
  
  # Déformations à +2 SD et -2 SD
  plus_2sd_x <- mean_x + 2 * sd_k * psi_kx
  plus_2sd_y <- mean_y + 2 * sd_k * psi_ky
  
  moins_2sd_x <- mean_x - 2 * sd_k * psi_kx
  moins_2sd_y <- mean_y - 2 * sd_k * psi_ky
  
  # Tracé du contour à +2 SD (Rouge)
  plot(plus_2sd_x, plus_2sd_y, type = "l", col = "red", lwd = 2, asp = 1,
       main = paste0("FPC", k, " (", var_pct[k], "%)"),
       xlab = "X", ylab = "Y")
  
  # Ajout de la déformation à -2 SD (Bleu pointillés)
  lines(moins_2sd_x, moins_2sd_y, col = "blue", lwd = 2, lty = 2)
  
  # Ajout du contour moyen (Noir)
  lines(mean_x, mean_y, col = "black", lwd = 1.5)
}

