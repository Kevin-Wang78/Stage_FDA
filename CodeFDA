############################ Lissage + Alignement ##############################

# Chargement du fichier contenant les contours extraits
mes_contours <- readRDS("C:/Users/kevin/Downloads/Stage_FDA/contours_extraits_partie1.rds")

# Filtrer les contours valides 
contours_valides <- Filter(function(x) !is.null(x) && nrow(x) > 120, mes_contours)

# Changement en base de Fourier 
base_fourier <- create.fourier.basis(rangeval = c(0, 2*pi), nbasis = 101)

# Centrer les contours
contour_to_fd <- function(contour) {
  
  # Centrage des donnees
  x <- contour$x - mean(contour$x)
  y <- contour$y - mean(contour$y)
  
  # Paramétrisation par longueur d'arc ramenée sur [0, 2pi]
  s <- c(0, cumsum(sqrt(diff(x)^2 + diff(y)^2)))
  t <- 2 * pi * s / max(s)
  
  # Lissage par Fourier
  list(
    x = smooth.basis(t, x, fdParobj = base_fourier)$fd,
    y = smooth.basis(t, y, fdParobj = base_fourier)$fd,
    t_x = mean(contour$x),
    t_y = mean(contour$y)
  )
}

# fonction qui va seulement tenir compte des contours valides
formes <- lapply(contours_valides, contour_to_fd)

# Alignement par Procrustes 
temps <- seq(0, 2*pi, length.out = 200) # Premier parametre
deltas <- seq(0, 2*pi, length.out = 40) # Deuxieme parametre

# Fonction pour trouver la rotation optimale 
rotation_opt <- function(x, y, x_reference, y_reference) {
  
  # Estimation de theta avec un delta fixe
  atan2(sum(x*y_reference - y*x_reference), sum(x*x_reference + y*y_reference))
}

moyenne <- formes[[1]]
nb_iter <- 10

# liste vide pour stocker les theta optimaux
liste_theta_optimal <- vector("list", length(formes))

# Iteration dans le but de voir si l'alignement a bien ete effectue
for (iter in 1:nb_iter) {
  
  # Aligner toutes les courbes a la premiere courbe comme reference
  x_reference <- eval.fd(temps, formes[[1]]$x)
  y_reference <- eval.fd(temps, formes[[1]]$y)
  
  formes_alignees <- lapply(seq_along(formes), function(i) {
    f <- formes[[i]]
    x <- eval.fd(temps, f$x)
    y <- eval.fd(temps, f$y)
    
    # Liste contenant les erreurs 
    erreurs <- numeric(length(deltas))
    
    # 2. La boucle for (variable de boucle renommée 'k' pour éviter le conflit avec 'iter')
    for (k in seq_along(deltas)) {
      
      d <- deltas[k]
      
      # Calcul des décalages x_s et y_s
      x_s <- approx(temps, x, (temps + d) %% (2 * pi), rule = 2)$y
      y_s <- approx(temps, y, (temps + d) %% (2 * pi), rule = 2)$y
      
      # Stockage de l'erreur dans l'élément 'k'
      erreurs[k] <- sum((x_s - x_reference)^2 + (y_s - y_reference)^2)
    }
    
    # Trouver le delta optimal qui minimise les erreurs
    d_opt <- deltas[which.min(erreurs)]
    x_shift <- approx(temps, x, (temps + d_opt) %% (2 * pi), rule = 2)$y
    y_shift <- approx(temps, y, (temps + d_opt) %% (2 * pi), rule = 2)$y
    
    # Rotation optimale
    theta <- rotation_opt(x_shift, y_shift, x_reference, y_reference)
    
    list(
      x = x_shift * cos(theta) - y_shift * sin(theta),
      y = x_shift * sin(theta) + y_shift * cos(theta),
      theta = theta
    )
  })
  
  # Extraire les thetas optimaux vers la variable globale
  liste_theta_optimal <- lapply(formes_alignees, `[[`, "theta")
  
  # Extraction propre en matrices pour la moyenne
  mat_x <- sapply(formes_alignees, `[[`, "x")
  mat_y <- sapply(formes_alignees, `[[`, "y")
  
  # Mise à jour de la moyenne apres avoir effectue le lissage et l'alignement
  moyenne$x <- smooth.basis(argvals = temps, y = rowMeans(mat_x), fdParobj = base_fourier)$fd
  moyenne$y <- smooth.basis(argvals = temps, y = rowMeans(mat_y), fdParobj = base_fourier)$fd  
  message("Itération ", iter, " / ", nb_iter, " terminée")
}

