#--------------------------- Lissage + Alignement ------------------------------

# Chargement du fichier contenant les contours extraits
mes_contours <- readRDS("C:/Users/kevin/Downloads/Stage_FDA/contours_extraits_partie1.rds")


i <- 1                                     # index initial
nb_images <- 7793                          # quantite de grains de beaute 
liste_fourier <- vector("list", nb_images) # liste pour stocker les donnees

# Utilisation de la base de Fourier pour les contours lisses et fermes
base_fourier <- create.fourier.basis(rangeval = c(0,2*pi), nbasis = 101)

# Boucle pour parcourir tous les grains de beaute
while (i <= nb_images) {
  
  # On choisit un contour par iteration
  contour_choisi <- mes_contours[[i]]
  
  # Si le contour est reel 
  if (!is.null(contour_choisi) && nrow(contour_choisi) > 5) {
    
    # Centrage des donnees
    x_centre <- contour_choisi$x - mean(contour_choisi$x)
    y_centre <- contour_choisi$y - mean(contour_choisi$y)
    
    coord_centre <- data.frame(x = x_centre, y = y_centre)
    pca <- prcomp(coord_centre, center = FALSE, scale. = FALSE)
    vecteur_principal <- pca$rotation[, 1]
    angle_principal <- atan2(vecteur_principal[2], vecteur_principal[1])
    
    theta_rotation <- -angle_principal
    cos_t <- cos(theta_rotation)
    sin_t <- sin(theta_rotation)
    
    # Alignement des coordonnees
    x_aligne <- x_centre * cos_t - y_centre *sin_t
    y_aligne <- x_centre * sin_t + y_centre * cos_t
    
    # Conversion en donnees polaires
    theta <- atan2(y_aligne, x_aligne)
    rayon <- sqrt(x_aligne^2 + y_aligne^2)
    
    # On ramene l'inveralle d'angle de 0 a 2pi
    theta_reconversion <- ifelse(theta < 0, theta + 2*pi, theta)
    
    # Triage
    ordre <- order(theta_reconversion)
    t_discret <- theta_reconversion[ordre] # Conversion en coordonnees polaires
    y_discret <- rayon[ordre]              # Conversion en coordonnees polaires
    
    # On essaie de lisser pour tous les grains de beaute
    liste_fourier[[i]] <- tryCatch({
      
      # Lissage des donnees avec smooth.basis
      lissage_resultat <- smooth.basis(argvals = t_discret, y = y_discret, fdParobj = base_fourier)
      
      lissage_resultat$fd
      
    }, error = function(e) {
      
      # Si on n'arrive pas a lisser
      NULL 
    })
  } else {
    liste_fourier[[i]] <- NULL
  }
  
  # incrementation de l'index
  i <- i + 1
  
  # Pour voir si ca progresse ou pas
  if (i %% 500 == 0) {
    message("Lissage bel et bien fonctionne")
  }
}

# Sauvegarde du lissage avec la base de Fourier
saveRDS(liste_fourier, "C:/Users/kevin/Downloads/Stage_FDA/contours_lisses_fourier.rds")

#------------------------------------ FPCA -------------------------------------

# Chargement du fichier contenant le lissage des grains de beaute
contours_fourier <- readRDS("C:/Users/kevin/Downloads/Stage_FDA/contours_lisses_fourier.rds")

# On s'assure de tenir compte seulement les lissages qui ont fonctionne
indices_valides <- which(!sapply(contours_fourier, is.null))

# Liste pour stocker les courbes des grains de beaute
liste_fpca <- liste_fourier[indices_valides] 

# Quantite de grains de beaute que le lissage a fonctionn
nb_valides <- length(liste_fpca)

# Valeurs des coefficients de Fourier
coefficients_fourier <- sapply(liste_fpca, function(x) x$coefs)

# Rappel a la base de Fourier avec tels coefficients
base_fourier2 <- liste_fpca[[1]]$basis

# Contient tous les contours avec les valeurs des coefficients
contours_total <- fd(coef = coefficients_fourier, basisobj = base_fourier2)

# Utilisation de l'algorithme de FPCA
resultats_fpca <- pca.fd(contours_total, nharm = 28)

# Valeurs de pourcentage des variances les plus grandes
variance_pourcentage <- resultats_fpca$varprop

# Variance additionne pour savoir quand s'arreter pour l'analyse
variance_cumulee <- cumsum(variance_pourcentage)

# Calcul des valeurs des plus grandes variances
affichage_variance <- data.frame(
  
  # Les 10 premieres fonctions propres ayant les plus grandes variances
  Composante = 1:10, 
  
  # Calcul arrondi de chacune des variances
  variance_individuelle <- round(variance_pourcentage[1:10] * 100, 2),
  variance_cumulee <- round(variance_cumulee[1:10] * 100, 2)
)

# Affichage des plus grandes variances
print(affichage_variance)

